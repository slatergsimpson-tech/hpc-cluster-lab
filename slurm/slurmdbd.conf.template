# slurmdbd.conf — SLURM accounting daemon (head01 only).
# Deploy to /etc/slurm/slurmdbd.conf, owner slurm:slurm mode 600 —
# slurmdbd refuses to start otherwise (it holds a DB password).
# @DBPASS@ is substituted at deploy time; never commit the real value.

AuthType=auth/munge
DbdHost=localhost
SlurmUser=slurm

StorageType=accounting_storage/mysql
StorageHost=localhost
StorageUser=slurm
StoragePass=@DBPASS@
StorageLoc=slurm_acct_db

LogFile=/var/log/slurm/slurmdbd.log
